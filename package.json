{
  "name": "quiznet",
  "version": "1.36.0",
  "quiznetRelease": {
    "stage": "alpha",
    "number": 35
  },
  "description": "Offline study quizzes for Windows.",
  "main": "src/main.cjs",
  "author": "iSariiSA",
  "license": "MIT",
  "scripts": {
    "assets:brand": "node scripts/build-brand.cjs",
    "assets:content": "node scripts/sync-content-vendor.cjs",
    "start": "electron .",
    "check": "node scripts/check-syntax.cjs && node scripts/sync-content-vendor.cjs --check && node scripts/sync-locales.cjs --check",
    "locales:sync": "node scripts/sync-locales.cjs",
    "test": "node --test tests/core.test.cjs tests/stability.test.cjs tests/recovery.test.cjs tests/updates.test.cjs tests/math.test.cjs tests/study-report.test.cjs tests/daily-review.test.cjs tests/mistake-notebook.test.cjs tests/saved-questions.test.cjs tests/release.test.cjs tests/history.test.cjs tests/library-organization.test.cjs tests/display-preferences.test.cjs tests/settings.test.cjs tests/quiz-appearance.test.cjs tests/i18n.test.cjs tests/response-types.test.cjs tests/response-controls.test.cjs tests/response-materials.test.cjs tests/showcase.test.cjs tests/study-aids.test.cjs",
    "test:app": "install-electron && playwright test",
    "release:info": "node scripts/release-info.cjs",
    "build": "node scripts/release-info.cjs && electron-builder --win nsis --x64 --publish never",
    "build:dir": "node scripts/release-info.cjs && electron-builder --win --dir --x64 --publish never"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@playwright/test": "1.64.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3"
  },
  "build": {
    "appId": "com.quiznet.desktop",
    "productName": "Quiznet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/brand/*.svg",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Quiznet-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quiznet",
      "uninstallDisplayName": "Quiznet",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
