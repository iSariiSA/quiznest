{
  "name": "quiznet",
  "version": "1.6.0",
  "quiznetRelease": {
    "stage": "alpha",
    "number": 3
  },
  "description": "Offline multiple-choice quizzes for Windows.",
  "main": "src/main.cjs",
  "author": "iSariiSA",
  "license": "MIT",
  "scripts": {
    "assets:brand": "node scripts/build-brand.cjs",
    "assets:content": "node scripts/sync-content-vendor.cjs",
    "start": "electron .",
    "check": "node scripts/check-syntax.cjs && node scripts/sync-content-vendor.cjs --check",
    "test": "node --test tests/core.test.cjs",
    "test:app": "playwright test",
    "release:info": "node scripts/release-info.cjs",
    "build": "node scripts/release-info.cjs && electron-builder --win nsis --x64 --publish never",
    "build:dir": "node scripts/release-info.cjs && electron-builder --win --dir --x64 --publish never"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "markdown-it": "15.0.3"
  },
  "build": {
    "appId": "com.quiznet.desktop",
    "productName": "Quiznet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/brand/*.svg",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Quiznet-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quiznet",
      "uninstallDisplayName": "Quiznet",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
